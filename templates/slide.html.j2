<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#0F1E33;--navy2:#17283F;--ph:#1C2E47;--line:#2A3D5A;--y:#FFC533;--cream:#F5F3EE;--muted:#9FB0C8;--soft:#C9D3E1;--ink2:#4A5A72}
*{box-sizing:border-box}
body{margin:0;width:1080px;height:1350px;overflow:hidden;font-family:Inter,sans-serif;background:var(--navy);color:var(--cream)}
.sg{font-family:'Space Grotesk',Inter,sans-serif}
.slide{width:1080px;height:1350px;padding:64px 64px 72px;display:flex;flex-direction:column;gap:32px;position:relative;overflow:hidden}
.top{display:flex;justify-content:space-between;align-items:center}
.brand{font-family:'Space Grotesk',Inter,sans-serif;font-weight:700;font-size:32px;letter-spacing:-.5px}
.brand span{color:var(--y)}
.count{font-family:'Space Grotesk',Inter,sans-serif;font-weight:500;font-size:26px;color:var(--muted)}
.kicker{color:var(--y);font-weight:700;font-size:26px;letter-spacing:2px}
.h1{font-family:'Space Grotesk',Inter,sans-serif;font-weight:700;font-size:68px;line-height:1.02;letter-spacing:-2px}
.sub{font-size:26px;color:var(--soft)}
.head{display:flex;flex-direction:column;gap:8px}
.ph{background:var(--ph);border-radius:20px;background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:20px;font-weight:500;flex:none}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.item{display:flex;flex-direction:column;gap:14px}
.item .name{font-weight:700;font-size:32px;line-height:1.15}
.desc{font-size:23px;line-height:1.4;color:var(--soft)}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:16px 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:none}
.row .n{font-weight:600;font-size:30px}
.row .d{font-size:24px;color:var(--soft);text-align:right}
.tipbox{margin-top:auto;background:var(--y);color:var(--navy);border-radius:18px;padding:20px 26px;font-size:23px;line-height:1.4;font-weight:600}
.notebox{margin-top:auto;border:2px solid var(--y);border-radius:18px;padding:20px 26px;font-size:23px;line-height:1.4}
.notebox b{color:var(--y)}
.card{background:var(--navy2);border-radius:22px;padding:26px;display:flex;flex-direction:column;gap:8px}
.tag{flex:0 0 150px;background:var(--y);color:var(--navy);font-weight:700;font-size:20px;text-align:center;padding:8px 0;border-radius:8px}
.credit{position:absolute;left:64px;right:64px;bottom:18px;font-size:13px;line-height:1.35;text-align:right;color:rgba(245,243,238,.7)}
</style>
</head>
<body>
{%- macro photo(p, h, label, radius=20) -%}
{%- if p and p.file -%}
<div class="ph" style="height:{{h}}px;border-radius:{{radius}}px;background-image:url('{{p.file}}')"></div>
{%- else -%}
<div class="ph" style="height:{{h}}px;border-radius:{{radius}}px">{{label}}</div>
{%- endif -%}
{%- endmacro -%}
{%- macro top(n) -%}
<div class="top"><div class="brand">ucuzbilet<span>ankara</span></div><div class="count">{{ '%02d' % n }} / 10</div></div>
{%- endmacro -%}

{% if slide == 'cover' %}
<div style="width:1080px;height:1350px;position:relative;overflow:hidden">
  {% if photos.cover and photos.cover.file %}
  <div style="position:absolute;inset:0;background:url('{{photos.cover.file}}') center/cover"></div>
  {% else %}
  <div style="position:absolute;inset:0;background:var(--ph)"></div>
  {% endif %}
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,30,51,.55) 0%,rgba(15,30,51,0) 18%,rgba(15,30,51,0) 30%,rgba(15,30,51,.88) 58%,rgba(15,30,51,.96) 100%)"></div>
  <div style="position:absolute;inset:0;padding:64px 64px 72px;display:flex;flex-direction:column;justify-content:space-between">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div class="top">
        <div class="brand" style="font-size:36px">ucuzbilet<span>ankara</span></div>
        <div class="count" style="color:var(--cream);background:var(--navy);padding:8px 18px;border-radius:999px">01 / 10</div>
      </div>
      {% if c.disclosure_badge %}<div style="align-self:flex-start;background:var(--cream);color:var(--navy);font-size:24px;font-weight:700;padding:8px 16px;border-radius:8px">{{ c.disclosure_badge }}</div>{% endif %}
    </div>
    <div style="display:flex;flex-direction:column;gap:28px">
      <div style="display:flex;flex-direction:column;gap:4px">
        <div style="align-self:flex-start;background:var(--y);color:var(--navy);font-weight:700;font-size:26px;letter-spacing:1.5px;padding:10px 20px;border-radius:10px">ANKARA'DAN DİREKT</div>
        <div class="sg" style="font-weight:700;font-size:{{ city_size }}px;line-height:.95;letter-spacing:-5px;margin-top:12px">{{ flight.city_name }}</div>
        <div style="font-size:34px;font-weight:500">{{ c.cover.subtitle }}</div>
      </div>
      <div style="background:var(--cream);color:var(--navy);border-radius:28px;display:flex;flex-direction:column">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:36px 44px 28px">
          <div style="display:flex;flex-direction:column;gap:2px">
            <div style="font-size:20px;font-weight:600;letter-spacing:1px;color:var(--ink2)">NEREDEN</div>
            <div class="sg" style="font-weight:700;font-size:72px;line-height:1">{{ flight.origin_airport or 'ESB' }}</div>
            <div style="font-size:24px;color:var(--ink2)">Ankara Esenboğa</div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:center;gap:6px">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#0F1E33" stroke-width="1.6" stroke-linejoin="round"><path d="M2.5 13.5l19-5.5-1-2.5-6.5 1.5-5-4.5-2 .5 3 5.5-4.5 1-2-2-1.5.5 1.5 4z"/><path d="M3 20h18"/></svg>
            <div style="font-size:20px;font-weight:600">Aktarmasız{% if flight.duration_txt %} · {{ flight.duration_txt }}{% endif %}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:2px;align-items:flex-end">
            <div style="font-size:20px;font-weight:600;letter-spacing:1px;color:var(--ink2)">NEREYE</div>
            <div class="sg" style="font-weight:700;font-size:72px;line-height:1">{{ flight.destination_airport }}</div>
            <div style="font-size:24px;color:var(--ink2);text-align:right">{{ c.airport_name }}</div>
          </div>
        </div>
        <div style="border-top:3px dashed #C9C4B8;margin:0 28px"></div>
        <div style="display:flex;align-items:flex-end;justify-content:space-between;padding:28px 44px 36px">
          <div style="display:flex;flex-direction:column;gap:6px;min-width:0">
            <div style="font-size:20px;font-weight:600;letter-spacing:1px;color:var(--ink2)">TARİH · {{ 'GİDİŞ-DÖNÜŞ' if flight.format == 'rt' else 'TEK YÖN' }}</div>
            <div class="sg" style="font-weight:700;font-size:44px">{{ flight.dates_txt }}</div>
            {% if flight.out_leg %}<div class="sg" style="font-weight:700;font-size:26px;white-space:nowrap">{% if flight.format == 'rt' %}Gidiş {% endif %}{{ flight.out_leg }}</div>{% endif %}
            {% if flight.format == 'rt' and flight.ret_leg %}<div class="sg" style="font-weight:700;font-size:26px;white-space:nowrap">Dönüş {{ flight.ret_leg }}</div>{% endif %}
            <div style="font-size:22px;color:var(--ink2)">{{ flight.airline_name }}{% if flight.flight_number %} {{ flight.flight_number.split(' ')[-1] }}{% endif %} · {{ 'iki yön de direkt' if flight.format == 'rt' else 'direkt uçuş' }} · yerel saat</div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex:none">
            <div class="sg" style="font-weight:700;font-size:{{ 88 if flight.price_txt|length <= 8 else 74 }}px;line-height:1;letter-spacing:-2px;white-space:nowrap">{{ flight.price_txt }}</div>
            <div style="font-size:20px;color:var(--ink2)">kişi başı, 'den başlayan</div>
          </div>
        </div>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;font-size:24px;font-weight:500">
        <span style="background:var(--navy);padding:8px 16px;border-radius:10px">Fiyatlar anlık değişebilir</span>
        <span style="background:var(--navy);padding:8px 16px;border-radius:10px">Rehber için kaydır →</span>
      </div>
    </div>
  </div>
</div>

{% elif slide == 'why_now' %}
<div class="slide">
  {{ top(2) }}
  <div class="head">
    <div class="kicker">NEDEN ŞİMDİ?</div>
    <div class="h1">{{ c.why_now.title }}</div>
    <div class="sub">{{ c.why_now.subtitle }}</div>
  </div>
  {{ photo(photos.why_now, 250, c.why_now.photo_label, 24) }}
  <div style="display:flex;flex-direction:column">
    {% for r in c.why_now.rows %}
    <div class="row"><div class="n">{{ r.name }}</div><div class="d">{{ r.detail }}</div></div>
    {% endfor %}
  </div>
  {% if c.why_now.tip %}<div class="tipbox">İpucu: {{ c.why_now.tip }}</div>{% endif %}
</div>

{% elif slide in ('sights_1', 'sights_2') %}
{% set s = c[slide] %}
<div class="slide">
  {{ top(3 if slide == 'sights_1' else 4) }}
  <div class="head">
    <div class="kicker">GEZİLECEK YERLER · {{ 'I' if slide == 'sights_1' else 'II' }}</div>
    <div class="h1">{{ s.title }}</div>
  </div>
  <div class="grid2">
    {% for it in s['items'] %}
    <div class="item">
      {{ photo(photos[slide ~ '_' ~ loop.index0], 210, it.name) }}
      <div class="name">{{ it.name }}</div>
      <div class="desc">{{ it.desc }}</div>
    </div>
    {% endfor %}
  </div>
</div>

{% elif slide == 'food' %}
<div class="slide">
  {{ top(5) }}
  <div class="head">
    <div class="kicker">NE YENİR?</div>
    <div class="h1">{{ c.food.title }}</div>
  </div>
  <div style="display:flex;flex-direction:column;gap:20px">
    {% for it in c.food['items'] %}
    <div style="display:flex;gap:28px;align-items:center;min-height:150px">
      {% if photos['food_' ~ loop.index0] %}<div style="flex:0 0 200px">{{ photo(photos['food_' ~ loop.index0], 150, '', 18) }}</div>
      {% else %}<div style="flex:0 0 8px;align-self:stretch;background:var(--y);border-radius:4px"></div>{% endif %}
      <div style="display:flex;flex-direction:column;gap:6px">
        <div style="font-weight:700;font-size:32px">{{ it.name }}</div>
        <div class="desc">{{ it.desc }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% if c.food.note %}<div class="notebox"><b>{{ c.food.note_title or 'Bilmekte fayda var' }}:</b> {{ c.food.note }}</div>{% endif %}
</div>

{% elif slide == 'eat' %}
<div class="slide">
  {{ top(6) }}
  <div class="head">
    <div class="kicker">NEREDE YENİR?</div>
    <div class="h1">{{ c.eat.title }}</div>
  </div>
  {{ photo(photos.eat, 200, '', 24) }}
  <div style="display:flex;flex-direction:column">
    {% for it in c.eat['items'] %}
    <div style="display:flex;gap:24px;padding:18px 0;align-items:flex-start;{% if not loop.last %}border-bottom:1px solid var(--line){% endif %}">
      <div class="tag">{{ it.tag | upper }}</div>
      <div style="display:flex;flex-direction:column;gap:4px"><div style="font-weight:700;font-size:30px">{{ it.name }}</div><div class="desc">{{ it.desc }}</div></div>
    </div>
    {% endfor %}
  </div>
  {% if c.eat.tip %}<div class="tipbox">{{ c.eat.tip }}</div>{% endif %}
</div>

{% elif slide == 'stay' %}
<div class="slide">
  {{ top(7) }}
  <div class="head">
    <div class="kicker">NEREDE KALINIR?</div>
    <div class="h1">{{ c.stay.title }}</div>
  </div>
  {{ photo(photos.stay, 220, '', 24) }}
  <div class="grid2" style="gap:24px">
    {% for it in c.stay['items'] %}
    <div class="card">
      <div class="sg" style="font-weight:700;font-size:44px;line-height:1;color:var(--y)">{{ it.badge }}</div>
      <div style="font-weight:700;font-size:30px">{{ it.name }}</div>
      <div class="desc">{{ it.desc }}</div>
    </div>
    {% endfor %}
  </div>
  {% if c.stay.footnote %}<div style="margin-top:auto;font-size:22px;color:var(--muted)">{{ c.stay.footnote }}</div>{% endif %}
</div>

{% elif slide == 'transport' %}
<div class="slide">
  {{ top(8) }}
  <div class="head">
    <div class="kicker">ULAŞIM</div>
    <div class="h1">{{ c.transport.title }}</div>
  </div>
  <div class="grid3">
    {% for it in c.transport.cards %}
    <div style="background:var(--cream);color:var(--navy);border-radius:22px;padding:26px;display:flex;flex-direction:column;gap:8px">
      <div style="font-size:20px;font-weight:700;letter-spacing:1px;color:var(--ink2)">{{ it.label | upper }}</div>
      <div class="sg" style="font-weight:700;font-size:40px;line-height:1">{{ it.name }}</div>
      <div style="font-size:22px;line-height:1.4">{{ it.desc }}</div>
    </div>
    {% endfor %}
  </div>
  {{ photo(photos.transport, 220, '', 24) }}
  <div style="display:flex;flex-direction:column;gap:22px">
    <div class="sg" style="font-weight:700;font-size:40px">Şehir içinde</div>
    {% for it in c.transport.city_items %}
    <div style="display:flex;gap:20px;align-items:flex-start">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#FFC533" stroke-width="2" stroke-linecap="round" style="flex:0 0 36px;margin-top:2px"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      <div style="font-size:24px;line-height:1.4;color:var(--soft)"><span style="color:var(--cream);font-weight:600">{{ it.bold }}</span> {{ it.text }}</div>
    </div>
    {% endfor %}
  </div>
</div>

{% elif slide == 'tips' %}
<div class="slide">
  {{ top(9) }}
  <div class="head">
    <div class="kicker">BİLMEDEN GİTME</div>
    <div class="h1">{{ c.tips.title }}</div>
  </div>
  <div class="grid2" style="gap:24px;flex-grow:1">
    {% for it in c.tips['items'] %}
    <div class="card" style="padding:30px;gap:10px">
      <div class="sg" style="font-weight:700;font-size:26px;color:var(--y)">{{ '%02d' % loop.index }} · {{ it.title }}</div>
      <div style="font-size:25px;line-height:1.4">{{ it.text }}</div>
    </div>
    {% endfor %}
  </div>
</div>

{% elif slide == 'closing' %}
<div class="slide" style="background:var(--y);color:var(--navy);gap:36px">
  <div class="top">
    <div class="brand">ucuzbilet<span style="color:var(--cream);background:var(--navy);padding:0 8px;border-radius:6px;margin-left:2px">ankara</span></div>
    <div class="count" style="color:var(--navy)">10 / 10</div>
  </div>
  <div style="display:flex;flex-direction:column;gap:14px">
    <div class="sg" style="font-weight:700;font-size:96px;line-height:.98;letter-spacing:-3px">{{ c.closing.title }}</div>
    <div style="font-size:32px;font-weight:500;line-height:1.35">{{ c.closing.subtitle }}</div>
  </div>
  <div style="background:var(--navy);color:var(--cream);border-radius:24px;padding:30px 36px;display:flex;justify-content:space-between;align-items:center;gap:24px">
    <div style="display:flex;flex-direction:column;gap:6px">
      <div class="sg" style="font-weight:700;font-size:40px">{{ flight.origin_airport or 'ESB' }} → {{ flight.destination_airport }} · {{ flight.dates_short }}{% if flight.dep_short %} · {{ flight.dep_short }}{% endif %}</div>
      <div style="font-size:22px;color:var(--soft)">{{ flight.airline_name }} · {{ 'iki yön direkt' if flight.format == 'rt' else 'direkt' }}{% if flight.duration_txt %} · {{ flight.duration_txt }}{% endif %}</div>
    </div>
    <div class="sg" style="font-weight:700;font-size:52px;color:var(--y);white-space:nowrap">{{ flight.price_txt }}</div>
  </div>
  <div class="grid3">
    <div style="background:var(--cream);border-radius:22px;padding:26px;display:flex;flex-direction:column;gap:10px">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0F1E33" stroke-width="1.8" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4z"/></svg>
      <div style="font-weight:700;font-size:28px">Kaydet</div>
      <div style="font-size:21px;line-height:1.4">Tatil planlarken rehber elinin altında olsun.</div>
    </div>
    <div style="background:var(--cream);border-radius:22px;padding:26px;display:flex;flex-direction:column;gap:10px">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0F1E33" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-6 7-6s7 2 7 6M19 8v6M16 11h6"/></svg>
      <div style="font-weight:700;font-size:28px">Takip et</div>
      <div style="font-size:21px;line-height:1.4">Her gün Ankara'dan yeni bir direkt uçuş.</div>
    </div>
    <div style="background:var(--cream);border-radius:22px;padding:26px;display:flex;flex-direction:column;gap:10px">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0F1E33" stroke-width="1.8" stroke-linejoin="round"><path d="M21 3L3 10l7 3 3 7z"/><path d="M10 13l4-4"/></svg>
      <div style="font-weight:700;font-size:28px">Gönder</div>
      <div style="font-size:21px;line-height:1.4">Birlikte gideceğin kişiye yolla.</div>
    </div>
  </div>
  {% if partner %}
  <div style="border:3px solid var(--navy);border-radius:22px;padding:24px 30px;font-size:25px;line-height:1.4">{{ partner }}</div>
  {% endif %}
  <div style="margin-top:auto;font-size:21px;line-height:1.4">Fiyat, paylaşım anında bulunan en düşük fiyattır. Havayolu sitesinde değişebilir.{% if c.disclosure_badge %} {{ c.disclosure_badge }}: profildeki bilet linki satış ortaklığı linkidir.{% endif %}</div>
</div>
{% endif %}
{% if credit %}<div class="credit"{% if slide == 'closing' %} style="color:rgba(15,30,51,.7)"{% endif %}>Fotoğraf: {{ credit }}</div>{% endif %}
</body>
</html>
